# Non-secret compatibility pairing. Hashes prove the selected build cohort;
# they are not a signature or authority to trust an untrusted installation.
foreach(name IN ITEMS RUNTIME_WORKER RUNTIME_HELPER RUNTIME_MANIFEST)
  if(NOT DEFINED ${name})
    message(FATAL_ERROR "Missing runtime cohort path")
  endif()
endforeach()
get_filename_component(worker_directory "${RUNTIME_WORKER}" DIRECTORY)
get_filename_component(helper_directory "${RUNTIME_HELPER}" DIRECTORY)
get_filename_component(manifest_directory "${RUNTIME_MANIFEST}" DIRECTORY)
get_filename_component(worker_name "${RUNTIME_WORKER}" NAME)
get_filename_component(helper_name "${RUNTIME_HELPER}" NAME)
get_filename_component(manifest_name "${RUNTIME_MANIFEST}" NAME)
if(NOT worker_directory STREQUAL helper_directory OR NOT worker_directory STREQUAL manifest_directory OR NOT manifest_name STREQUAL "rdp-worker.runtime.json")
  message(FATAL_ERROR "Expected colocated runtime cohort artifacts")
endif()
if(NOT (worker_name STREQUAL "rdp-worker" AND helper_name STREQUAL "rdp-runtime-recovery") AND NOT (worker_name STREQUAL "rdp-worker.exe" AND helper_name STREQUAL "rdp-runtime-recovery.exe"))
  message(FATAL_ERROR "Unexpected runtime cohort names")
endif()
file(SHA256 "${RUNTIME_WORKER}" worker_hash)
file(SHA256 "${RUNTIME_HELPER}" helper_hash)
file(WRITE "${RUNTIME_MANIFEST}" "{\"v\":1,\"directorySchema\":1,\"worker\":\"${worker_name}\",\"helper\":\"${helper_name}\",\"workerSha256\":\"${worker_hash}\",\"helperSha256\":\"${helper_hash}\"}\n")
