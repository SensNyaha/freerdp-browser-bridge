# Apply to the verified pinned FreeRDP source, not the bridge CMake project.
set(WITH_CLIENT_COMMON ON CACHE BOOL "" FORCE)
set(WITH_CLIENT OFF CACHE BOOL "" FORCE)
set(WITH_SERVER OFF CACHE BOOL "" FORCE)
set(WITH_SAMPLE OFF CACHE BOOL "" FORCE)
set(WITH_X11 OFF CACHE BOOL "" FORCE)
set(WITH_WAYLAND OFF CACHE BOOL "" FORCE)
set(WITH_CLIENT_SDL OFF CACHE BOOL "" FORCE)
set(WITH_CHANNELS ON CACHE BOOL "" FORCE)
set(WITH_CLIENT_CHANNELS ON CACHE BOOL "" FORCE)
set(WITH_SERVER_CHANNELS OFF CACHE BOOL "" FORCE)
set(WITH_PULSE OFF CACHE BOOL "" FORCE)
set(WITH_ALSA OFF CACHE BOOL "" FORCE)
set(WITH_OSS OFF CACHE BOOL "" FORCE)
set(WITH_SNDIO OFF CACHE BOOL "" FORCE)
set(WITH_MANPAGES OFF CACHE BOOL "" FORCE)
set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
foreach(channel AUDIN CLIPRDR DRIVE RDPDR PRINTER SERIAL PARALLEL SMARTCARD RDPSND DRDYNVC URBDRC)
  set(CHANNEL_${channel} ON CACHE BOOL "" FORCE)
  set(CHANNEL_${channel}_CLIENT ON CACHE BOOL "" FORCE)
endforeach()
# Runtime channel support still requires OS libraries, plugins, policy and E2E tests.
