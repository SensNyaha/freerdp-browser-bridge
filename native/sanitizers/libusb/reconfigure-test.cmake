cmake_minimum_required(VERSION 3.24)

foreach(required IN ITEMS FIXTURE_SOURCE PINNED_SOURCE TEST_ROOT C_COMPILER CXX_COMPILER)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing reconfigure test input: ${required}")
  endif()
endforeach()
set(project "${TEST_ROOT}/project")
set(binary "${TEST_ROOT}/binary")
file(MAKE_DIRECTORY "${project}")
foreach(name IN ITEMS CMakeLists.txt config.h.in regression.cpp interface-ownership.patch)
  configure_file("${FIXTURE_SOURCE}/${name}" "${project}/${name}" COPYONLY)
endforeach()
configure_file("${CMAKE_CURRENT_LIST_FILE}" "${project}/reconfigure-test.cmake" COPYONLY)

function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Reconfigure test command failed (${result}): ${output}${error}")
  endif()
endfunction()
file(SHA256 "${PINNED_SOURCE}/libusb/descriptor.c" original_hash)
run("${CMAKE_COMMAND}" -S "${project}" -B "${binary}" -G Ninja
  -DCMAKE_BUILD_TYPE=Debug "-DCMAKE_C_COMPILER=${C_COMPILER}"
  "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}" "-DBRIDGE_LIBUSB_SOURCE=${PINNED_SOURCE}")
run("${CMAKE_COMMAND}" --build "${binary}" --parallel 2)
file(READ "${binary}/pinned-libusb/libusb/descriptor.c" before)
file(READ "${project}/interface-ownership.patch" patch)
# Change only a comment in a private project copy; parser semantics stay fixed.
string(REPLACE "Retire this slot" "Release this slot" changed_patch "${patch}")
if(changed_patch STREQUAL patch)
  message(FATAL_ERROR "Expected patch comment was absent")
endif()
file(WRITE "${project}/interface-ownership.patch" "${changed_patch}")
run("${CMAKE_COMMAND}" --build "${binary}" --parallel 2)
file(READ "${binary}/pinned-libusb/libusb/descriptor.c" after)
string(REPLACE "Retire this slot" "Release this slot" expected "${before}")
if(NOT after STREQUAL expected)
  message(FATAL_ERROR "Prepared descriptor did not follow changed patch")
endif()
file(WRITE "${project}/interface-ownership.patch" "${patch}")
run("${CMAKE_COMMAND}" --build "${binary}" --parallel 2)
file(READ "${binary}/pinned-libusb/libusb/descriptor.c" restored)
if(NOT restored STREQUAL before)
  message(FATAL_ERROR "Prepared descriptor did not follow restored patch")
endif()
run("${CMAKE_COMMAND}" --build "${binary}" --parallel 2)
file(SHA256 "${PINNED_SOURCE}/libusb/descriptor.c" final_hash)
if(NOT final_hash STREQUAL original_hash)
  message(FATAL_ERROR "Original pinned source changed")
endif()
message(STATUS "Patch edit/restore/incremental build pass; pinned source unchanged")
