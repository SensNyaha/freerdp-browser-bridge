# Build-copy correction for the exact public FreeRDP 3.32.1 DSP source.
# The source checkout and public ABI remain unchanged.
function(bridge_write_dsp_override input output)
  if(NOT EXISTS "${input}" OR IS_DIRECTORY "${input}" OR IS_SYMLINK "${input}")
    message(FATAL_ERROR "Pinned FreeRDP DSP source must be a regular file")
  endif()
  file(SIZE "${input}" bridge_dsp_size)
  if(bridge_dsp_size GREATER 131072)
    message(FATAL_ERROR "Pinned FreeRDP DSP source exceeds its bound")
  endif()
  file(READ "${input}" bridge_dsp_source)
  string(REPLACE "\r\n" "\n" bridge_dsp_source "${bridge_dsp_source}")
  string(SHA256 bridge_dsp_hash "${bridge_dsp_source}")
  if(NOT bridge_dsp_hash STREQUAL "40715894dc14e2869c64bbf3ebfcf209fe12483890ffb709133d7034f32ad10f")
    message(FATAL_ERROR "Pinned FreeRDP DSP source hash mismatch")
  endif()
  set(bridge_dsp_anchor "\tif (!context || !targetFormat)\n\t\treturn FALSE;\n\n\tcontext->common.format = *targetFormat;")
  set(bridge_dsp_replacement "\tif (!context || !targetFormat)\n\t\treturn FALSE;\n\n#if defined(WITH_OPUS)\n\t/* Bridge dsp-opus-reset-ownership-v1: retire the preceding codec before replacement. */\n\tif (context->opus_decoder)\n\t{\n\t\topus_decoder_destroy(context->opus_decoder);\n\t\tcontext->opus_decoder = nullptr;\n\t}\n\tif (context->opus_encoder)\n\t{\n\t\topus_encoder_destroy(context->opus_encoder);\n\t\tcontext->opus_encoder = nullptr;\n\t}\n#endif\n\n\tcontext->common.format = *targetFormat;")
  string(REPLACE "${bridge_dsp_anchor}" "${bridge_dsp_replacement}" bridge_dsp_patched "${bridge_dsp_source}")
  if(bridge_dsp_patched STREQUAL bridge_dsp_source)
    message(FATAL_ERROR "Pinned FreeRDP DSP reset anchor missing")
  endif()
  string(SHA256 bridge_dsp_output_hash "${bridge_dsp_patched}")
  if(NOT bridge_dsp_output_hash STREQUAL "f1da137622368914628be9ef79888186bb6a9a1dc7e5fa77771535c061dae35a")
    message(FATAL_ERROR "Pinned FreeRDP DSP override output hash mismatch")
  endif()
  set(bridge_dsp_existing_hash "")
  if(EXISTS "${output}")
    file(SHA256 "${output}" bridge_dsp_existing_hash)
  endif()
  if(NOT bridge_dsp_existing_hash STREQUAL bridge_dsp_output_hash)
    file(CONFIGURE OUTPUT "${output}" CONTENT "${bridge_dsp_patched}" @ONLY NEWLINE_STYLE LF)
  endif()
  file(SHA256 "${output}" bridge_written_hash)
  if(NOT bridge_written_hash STREQUAL bridge_dsp_output_hash)
    message(FATAL_ERROR "Pinned FreeRDP DSP build-copy bytes mismatch")
  endif()
endfunction()

function(bridge_require_freerdp_overrides prefix)
  set(bridge_manifest "${prefix}/share/freerdp-bridge/freerdp-overrides.json")
  if(NOT EXISTS "${bridge_manifest}" OR IS_DIRECTORY "${bridge_manifest}" OR IS_SYMLINK "${bridge_manifest}")
    message(FATAL_ERROR "Rebuild the pinned FreeRDP SDK with the DSP ownership override")
  endif()
  file(SIZE "${bridge_manifest}" bridge_manifest_size)
  if(bridge_manifest_size GREATER 4096)
    message(FATAL_ERROR "Pinned FreeRDP override metadata exceeds its bound")
  endif()
  file(READ "${bridge_manifest}" bridge_manifest_json)
  file(READ "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" bridge_recipe)
  string(REPLACE "\r\n" "\n" bridge_recipe "${bridge_recipe}")
  string(SHA256 bridge_expected_recipe "${bridge_recipe}")
  foreach(bridge_field schema id sourceCommit sourceSha256 recipeSha256 outputSha256)
    string(JSON bridge_value ERROR_VARIABLE bridge_json_error GET "${bridge_manifest_json}" "${bridge_field}")
    if(bridge_json_error)
      message(FATAL_ERROR "Invalid pinned FreeRDP override metadata")
    endif()
    set("bridge_override_${bridge_field}" "${bridge_value}")
  endforeach()
  if(NOT bridge_override_schema STREQUAL "1" OR
     NOT bridge_override_id STREQUAL "dsp-opus-reset-ownership-v1" OR
     NOT bridge_override_sourceCommit STREQUAL "bf217a504e54cc719880c228e82353382cd7d4fa" OR
     NOT bridge_override_sourceSha256 STREQUAL "40715894dc14e2869c64bbf3ebfcf209fe12483890ffb709133d7034f32ad10f" OR
     NOT bridge_override_recipeSha256 STREQUAL bridge_expected_recipe OR
     NOT bridge_override_outputSha256 STREQUAL "f1da137622368914628be9ef79888186bb6a9a1dc7e5fa77771535c061dae35a")
    message(FATAL_ERROR "Pinned FreeRDP DSP ownership override mismatch; rebuild the SDK")
  endif()
endfunction()
