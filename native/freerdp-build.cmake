include("${CMAKE_CURRENT_LIST_DIR}/msvc-dependencies.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/freerdp-dsp-override.cmake")

function(bridge_apply_freerdp_overrides)
  if(NOT TARGET freerdp-codecs)
    message(FATAL_ERROR "Pinned FreeRDP codec target missing")
  endif()
  set(bridge_dsp_input "${CMAKE_SOURCE_DIR}/libfreerdp/codec/dsp.c")
  set(bridge_override_root "${CMAKE_BINARY_DIR}/bridge-overrides")
  set(bridge_dsp_output "${bridge_override_root}/dsp.c")
  file(MAKE_DIRECTORY "${bridge_override_root}")
  bridge_write_dsp_override("${bridge_dsp_input}" "${bridge_dsp_output}")
  get_target_property(bridge_codec_dir freerdp-codecs SOURCE_DIR)
  get_target_property(bridge_codec_sources freerdp-codecs SOURCES)
  set(bridge_replaced FALSE)
  set(bridge_patched_sources)
  foreach(bridge_source IN LISTS bridge_codec_sources)
    cmake_path(ABSOLUTE_PATH bridge_source BASE_DIRECTORY "${bridge_codec_dir}" NORMALIZE OUTPUT_VARIABLE bridge_absolute_source)
    if(bridge_absolute_source STREQUAL bridge_dsp_input)
      list(APPEND bridge_patched_sources "${bridge_dsp_output}")
      set(bridge_replaced TRUE)
    else()
      list(APPEND bridge_patched_sources "${bridge_source}")
    endif()
  endforeach()
  if(NOT bridge_replaced)
    message(FATAL_ERROR "Pinned FreeRDP DSP target source missing")
  endif()
  set_property(TARGET freerdp-codecs PROPERTY SOURCES "${bridge_patched_sources}")
  target_include_directories(freerdp-codecs PRIVATE "${CMAKE_SOURCE_DIR}/libfreerdp/codec")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${bridge_dsp_input}")
  file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/freerdp-dsp-override.cmake" bridge_recipe)
  string(REPLACE "\r\n" "\n" bridge_recipe "${bridge_recipe}")
  string(SHA256 bridge_recipe_hash "${bridge_recipe}")
  file(SHA256 "${bridge_dsp_output}" bridge_output_hash)
  set(bridge_manifest "${bridge_override_root}/freerdp-overrides.json")
  file(WRITE "${bridge_manifest}" "{\"schema\":1,\"id\":\"dsp-opus-reset-ownership-v1\",\"sourceCommit\":\"bf217a504e54cc719880c228e82353382cd7d4fa\",\"sourceSha256\":\"40715894dc14e2869c64bbf3ebfcf209fe12483890ffb709133d7034f32ad10f\",\"recipeSha256\":\"${bridge_recipe_hash}\",\"outputSha256\":\"${bridge_output_hash}\"}\n")
  install(FILES "${bridge_manifest}" DESTINATION share/freerdp-bridge)
  install(FILES "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/freerdp-dsp-override.cmake" DESTINATION share/freerdp-bridge/overrides)
endfunction()

cmake_language(DEFER CALL bridge_apply_freerdp_overrides)
