* text=auto eol=lf
*.png binary
*.zip binary
# Unified diff context uses a space on otherwise empty lines.
# The final context line can also represent an empty source line.
native/vcpkg/ports/**/*.patch whitespace=-blank-at-eol,-blank-at-eof
# Unified diff context precedes the pinned libusb source's tab indentation.
native/sanitizers/libusb/interface-ownership.patch whitespace=-space-before-tab
