{
  "name": "freerdp-node-bridge-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write apps packages scripts tests examples .github \"*.{json,yaml,yml,mjs,js,cjs,ts,html,css}\" .prettierrc.json",
    "format:check": "prettier --check apps packages scripts tests examples .github \"*.{json,yaml,yml,mjs,js,cjs,ts,html,css}\" .prettierrc.json",
    "check": "pnpm build && pnpm lint && pnpm format:check && pnpm test",
    "build:native": "cmake --preset foundation && cmake --build --preset foundation",
    "test:native": "ctest --preset foundation",
    "build:dependencies": "node scripts/build-dependencies.mjs",
    "build:freerdp": "node scripts/build-freerdp.mjs",
    "build:bundled": "node scripts/build-bundled.mjs",
    "test:bundle": "node --test tests/packaging/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "eslint": "10.12.0",
    "playwright-core": "1.64.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
