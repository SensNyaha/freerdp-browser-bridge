{
  "name": "freerdp-node-bridge-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm build && pnpm lint && pnpm format:check && pnpm test",
    "build:native": "cmake --preset foundation && cmake --build --preset foundation",
    "test:native": "ctest --preset foundation"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.1",
    "prettier": "3.6.2"
  }
}
